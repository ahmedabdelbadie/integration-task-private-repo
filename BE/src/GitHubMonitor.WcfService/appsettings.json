{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Quartz": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GitHub": {
    "ApiBaseUrl": "https://api.github.com/",
    "Owner": "ahmedabdelbadie",
    "Repository": "integration-task-private-repo",
    "UserAgent": "IntegrationTaskApp",
    "CommitCount": 10,
    "TimeoutSeconds": 15
  },
  "Scheduler": {
    "IntervalSeconds": 60
  },
  "Cache": {
    "FilePath": "App_Data/commits-cache.json"
  }
}
